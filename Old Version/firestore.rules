// ============================================================================
// FÊNIX | firestore.rules (Biblioteca Fênix v3.9)
// PROPOSTA de regras de segurança do Firestore para as coleções que o Fênix
// Core usa. Antes de publicar, compare com o que está hoje no console do
// Firebase (projeto fenix-core): o que existir lá e não estiver aqui precisa
// ser conservado. Teste no "Playground de regras" do console antes de publicar.
//
// Princípios (regra 46 do Livro): nada fica aberto; só usuário logado; dados
// de uma empresa só para os membros aprovados dela; ações de gestão só para o
// dono. Tudo que não está liberado aqui é negado (último bloco).
//
// Coleções do core:
//   empresas/{empresaId}                 dados da empresa (donoUid)
//   empresas/{empresaId}/membros/{uid}   equipe (papel: dono | tecnico)
//   empresas/{empresaId}/{qualquer}      pessoas, appData, materiais, famílias,
//                                        produtos e serviços da empresa
//   usuarios_empresa/{uid}               vínculo rápido usuário -> empresa
//   convites/{token}                     convites por link
//   pessoas_fisicas, pessoas_juridicas, produtos_servicos, cidades (+bairros)
//                                        base compartilhada (só com o banco ativo)
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funções de apoio ----------
    function logado() {
      return request.auth != null;
    }
    function caminhoMembro(empresaId, uid) {
      return /databases/$(database)/documents/empresas/$(empresaId)/membros/$(uid);
    }
    function ehMembro(empresaId) {
      return logado()
        && exists(caminhoMembro(empresaId, request.auth.uid))
        && get(caminhoMembro(empresaId, request.auth.uid)).data.status == 'aprovado';
    }
    function ehDono(empresaId) {
      return ehMembro(empresaId)
        && get(caminhoMembro(empresaId, request.auth.uid)).data.papel == 'dono';
    }
    function vinculoCombinaComMembro(d, uid) {
      return exists(caminhoMembro(d.empresaId, uid))
        && get(caminhoMembro(d.empresaId, uid)).data.papel == d.papel;
    }

    // ---------- empresas ----------
    match /empresas/{empresaId} {
      allow create: if logado() && request.resource.data.donoUid == request.auth.uid;
      allow read: if ehMembro(empresaId) || (logado() && resource.data.donoUid == request.auth.uid);
      allow update: if ehDono(empresaId);
      allow delete: if ehDono(empresaId);

      // equipe
      match /membros/{uid} {
        allow read: if logado() && (request.auth.uid == uid || ehMembro(empresaId));
        // O dono cria o próprio registro ao criar a empresa; quem aceita um
        // convite cria o seu como "tecnico". LIMITAÇÃO: a regra não consegue
        // conferir o token do convite (o core não o grava no registro), então
        // quem souber o código da empresa (aleatório, longo) poderia se
        // cadastrar como técnico. Para fechar, o core precisaria gravar o token.
        allow create: if logado() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/empresas/$(empresaId))
          && (
            (request.resource.data.papel == 'dono'
              && get(/databases/$(database)/documents/empresas/$(empresaId)).data.donoUid == uid)
            || request.resource.data.papel == 'tecnico'
          );
        allow update: if ehDono(empresaId);
        allow delete: if logado() && (request.auth.uid == uid || ehDono(empresaId));
      }

      // todo o resto dentro da empresa (pessoas, appData, materiais, famílias,
      // produtos e serviços, coleções criadas por cada app): só membros
      // aprovados. A coleção "membros" fica de fora porque tem regra própria.
      match /{colecao}/{docId} {
        allow read, write: if colecao != 'membros' && ehMembro(empresaId);
      }
    }

    // ---------- vínculo usuário -> empresa ----------
    match /usuarios_empresa/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid
        && vinculoCombinaComMembro(request.resource.data, uid);
      allow delete: if logado() && (request.auth.uid == uid || ehDono(resource.data.empresaId));
    }

    // ---------- convites ----------
    match /convites/{token} {
      // O token é longo e aleatório. Se um app precisar ler o convite ANTES do
      // login, troque a linha abaixo por "allow get: if true;".
      allow get: if logado();
      allow list: if logado() && ehMembro(resource.data.empresaId);
      allow create: if logado()
        && ehDono(request.resource.data.empresaId)
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.usado == false;
      allow update: if logado() && (
        // dono cancela
        (ehDono(resource.data.empresaId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelado']))
        // convidado aceita (uma vez)
        || (resource.data.usado == false && resource.data.cancelado == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado', 'usadoPorUid', 'usadoEm'])
          && request.resource.data.usado == true
          && request.resource.data.usadoPorUid == request.auth.uid)
      );
      allow delete: if false;
    }

    // ---------- base compartilhada (só com o banco ativo) ----------
    // Por desenho do core, estas coleções são comuns a todos os apps. Qualquer
    // usuário logado lê e grava. Se quiser restringir (por exemplo, exigir
    // vínculo com uma empresa), troque logado() pela condição desejada.
    match /pessoas_fisicas/{id}   { allow read, write: if logado(); }
    match /pessoas_juridicas/{id} { allow read, write: if logado(); }
    match /produtos_servicos/{id} { allow read, write: if logado(); }
    match /cidades/{ibge} {
      allow read, write: if logado();
      match /bairros/{bairro} { allow read, write: if logado(); }
    }

    // ---------- modelo para coleção própria de um app (dados só do dono) ----------
    // match /fenix_nome_do_app/{uid}/{resto=**} {
    //   allow read, write: if logado() && request.auth.uid == uid;
    // }

    // ---------- tudo o mais é negado ----------
    match /{outros=**} {
      allow read, write: if false;
    }
  }
}
